generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  reviewProgress ReviewProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deck {
  id             String   @id @default(cuid())
  title          String
  sourceFilename String   @unique
  sourceType     String   @default("csv")
  hasBeenIntroduced Boolean @default(false)
  learningPhase  String   @default("intro")
  ownerId        String?
  createdAt      DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  cards Card[]
  reviewProgress ReviewProgress[]
}

model Card {
  id        String   @id @default(cuid())
  deckId    String
  question  String
  answer    String
  seen      Boolean  @default(false)
  hasScaffoldedExplanation Boolean @default(false)
  state     String   @default("unseen")
  createdAt DateTime @default(now())

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviewProgress ReviewProgress[]

  @@unique([deckId, question])
}

model ReviewProgress {
  id          String   @id @default(cuid())
  userId      String
  deckId      String
  cardId      String
  status      String   @default("new")
  reviewCount Int      @default(0)
  nextReview  DateTime?
  lastActionAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
}
