# OpenAI API Key (set to the API key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=OPENAI_API_KEY
# Groq API Key (set to the API key from https://console.groq.com/keys)
GROQ_API_KEY=GROQ_API_KEY
# Prisma DB URL for local SQLite (keep default unless you move the db file)
DATABASE_URL="file:./dev.db"
# NextAuth base URL for local dev
NEXTAUTH_URL=http://localhost:3000
# NextAuth secret (set to a long random string; e.g. output of `openssl rand -hex 32`)
NEXTAUTH_SECRET=CHANGEME
# App URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET

# PRICING
BILLING_PREMIUM_PRICE_MONTHLY=9
BILLING_PREMIUM_PRICE_YEARLY=86
BILLING_ULTIMATE_PRICE_MONTHLY=15
BILLING_ULTIMATE_PRICE_YEARLY=144

# STRIPE
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_YEARLY=

# LIMITS
PLAN_FREE_MAX_DECKS=3
PLAN_FREE_MAX_QUESTIONS_PER_DECK=10
PLAN_FREE_DAILY_EXPLANATION_SECONDS=300

PLAN_PREMIUM_MAX_DECKS=-1
PLAN_PREMIUM_MAX_QUESTIONS_PER_DECK=25
PLAN_PREMIUM_DAILY_EXPLANATION_MINUTES=30

PLAN_ULTIMATE_MAX_DECKS=-1
PLAN_ULTIMATE_MAX_QUESTIONS_PER_DECK=50
PLAN_ULTIMATE_DAILY_EXPLANATION_MINUTES=-1
